Experiment No 9. Implement the ANN algorithm on a data set obtained from UCI ML repository
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.neural_network import MLPClassifier
from sklearn.metrics import accuracy_score
from sklearn.preprocessing import StandardScaler

d = {
    'Age': [20, 22, 25, 30, 35, 40, 45, 50, 23, 32],
    'Salary': [20000, 25000, 30000, 35000, 40000, 45000, 50000, 55000, 28000, 38000],
    'Buy': ['No', 'No', 'No', 'No', 'Yes', 'Yes', 'Yes', 'Yes', 'No', 'Yes']
}

df = pd.DataFrame(d)

x = df[['Age', 'Salary']]
y = df['Buy']

x1, x2, y1, y2 = train_test_split(x, y, test_size=0.3, random_state=1)

s = StandardScaler()
x1 = s.fit_transform(x1)
x2 = s.transform(x2)

m = MLPClassifier(hidden_layer_sizes=(5,), max_iter=1000, random_state=1)
m.fit(x1, y1)

p = m.predict(x2)

print("Actual:", list(y2))
print("Predicted:", list(p))
print("Accuracy:", accuracy_score(y2, p) * 100, "%")

