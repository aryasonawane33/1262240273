Experiment No 10.  Apply PCA and SVD on a data set obtained from UCI ML repository
import pandas as pd
from sklearn.decomposition import PCA, TruncatedSVD
from sklearn.preprocessing import StandardScaler

d = {
    'Age': [20, 22, 25, 30, 35, 40],
    'Salary': [20000, 25000, 30000, 35000, 40000, 45000],
    'Marks': [60, 65, 70, 75, 80, 85]
}

df = pd.DataFrame(d)

s = StandardScaler()
x = s.fit_transform(df)

p = PCA(n_components=2)
a = p.fit_transform(x)

v = TruncatedSVD(n_components=2)
b = v.fit_transform(x)

print("PCA Result:")
print(a)

print("SVD Result:")
print(b)


