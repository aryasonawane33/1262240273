Experiment No 7. Train the system using data set obtained from UCI ML repository. Use a partition of the same data set as a test set to determine accuracy using KNN classifier. 
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score

d = {
    'Age': [20, 22, 25, 30, 35, 40, 45, 50, 23, 32],
    'Salary': [20000, 25000, 30000, 35000, 40000, 45000, 50000, 55000, 28000, 38000],
    'Buy': ['No', 'No', 'No', 'No', 'Yes', 'Yes', 'Yes', 'Yes', 'No', 'Yes']
}

df = pd.DataFrame(d)

x = df[['Age', 'Salary']]
y = df['Buy']

x1, x2, y1, y2 = train_test_split(x, y, test_size=0.3, random_state=1)

m = KNeighborsClassifier(n_neighbors=3)
m.fit(x1, y1)

p = m.predict(x2)

print("Actual:", list(y2))
print("Predicted:", list(p))
print("Accuracy:", accuracy_score(y2, p) * 100, "%")

