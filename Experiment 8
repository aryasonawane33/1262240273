Experiment No 8. Train the system using data set obtained from UCI ML repository. Use a partition of the same data set as a test set to determine accuracy using Kmeans clustering
import pandas as pd
from sklearn.cluster import KMeans
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score
from sklearn.metrics import adjusted_rand_score

d = {
    'Age': [20, 22, 25, 30, 35, 40, 45, 50, 23, 32],
    'Salary': [20000, 25000, 30000, 35000, 40000, 45000, 50000, 55000, 28000, 38000]
}

df = pd.DataFrame(d)

x1, x2 = train_test_split(df, test_size=0.3, random_state=1)

m = KMeans(n_clusters=2, random_state=1, n_init=10)
m.fit(x1)

p = m.predict(x2)

print("Predicted Clusters:", list(p))
print("Cluster Centers:")
print(m.cluster_centers_)
print("Accuracy:", adjusted_rand_score(
    [0, 1, 0], p
) * 100, "%")
